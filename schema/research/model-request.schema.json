{
  "$id": "https://kinescope.dev/schema/model-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public model request",
  "type": "object",
  "required": [
    "schema",
    "requestId",
    "requestDigest",
    "itemId",
    "taskId",
    "split",
    "provider",
    "messages",
    "responseSchema",
    "generation"
  ],
  "properties": {
    "schema": {
      "const": "kinescope.model-request.v1"
    },
    "requestId": {
      "type": "string"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[a-z0-9-]+1-[0-9a-f]{32}$"
    },
    "itemId": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "split": {
      "type": "string"
    },
    "provider": {
      "type": "object"
    },
    "promptVersion": {
      "type": "string"
    },
    "promptDigest": {
      "type": "string",
      "pattern": "^[a-z0-9-]+1-[0-9a-f]{32}$"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "responseSchema": {
      "type": "object"
    },
    "generation": {
      "type": "object"
    }
  }
}
