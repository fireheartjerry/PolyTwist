{
  "$id": "https://polytwist.dev/schema/ideal-rigid-display-experiment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PolyTwist ideal-rigid display closure experiment",
  "type": "object",
  "required": [
    "schema",
    "certificationSchema",
    "valid",
    "protocol",
    "summary",
    "failures",
    "artifacts",
    "limitations",
    "reportDigest"
  ],
  "properties": {
    "schema": {
      "const": "polytwist.ideal-rigid-display-experiment.v1"
    },
    "certificationSchema": {
      "const": "polytwist.ideal-rigid-display-certificate.v1"
    },
    "valid": {
      "type": "boolean"
    },
    "protocol": {
      "type": "object",
      "required": [
        "seed",
        "stateCount",
        "progressSamples",
        "artifactIds",
        "assertions"
      ]
    },
    "summary": {
      "type": "object",
      "required": [
        "artifactCount",
        "stateCount",
        "dockedCertificates",
        "legalMoveChecks",
        "blockedMoveObservations",
        "animationCertificates",
        "committedTurnCertificates",
        "inverseRestorations"
      ]
    },
    "failures": {
      "type": "array"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifactId",
          "puzzleId",
          "family",
          "geometryHash",
          "sourceExactness",
          "logicalPieces",
          "renderablePieces",
          "bandageCount",
          "scramble",
          "actionCoverage",
          "counts",
          "finalStateFingerprint"
        ],
        "properties": {
          "geometryHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reportDigest": {
      "type": "string",
      "pattern": "^ideal-rigid-display-experiment1-[0-9a-f]{32}$"
    }
  }
}
