{
  "$id": "https://kinescope.dev/schema/run-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental run manifest",
  "type": "object",
  "required": [
    "schema",
    "runId",
    "suiteId",
    "provider",
    "status",
    "startedAt",
    "completedAt",
    "counts",
    "usage"
  ],
  "properties": {
    "schema": {
      "const": "kinescope.run-manifest.v1"
    },
    "runId": {
      "type": "string"
    },
    "suiteId": {
      "type": [
        "string",
        "null"
      ]
    },
    "suiteDigest": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "completed-with-item-failures",
        "completed-with-evaluation-error"
      ]
    },
    "provider": {
      "type": "object"
    },
    "contamination": {
      "type": "object"
    },
    "prompt": {
      "type": "object"
    },
    "execution": {
      "type": "object"
    },
    "seed": {
      "type": "string"
    },
    "environment": {
      "type": "object"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "counts": {
      "type": "object"
    },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "budget": {
      "type": "object"
    },
    "evaluationError": {
      "type": [
        "object",
        "null"
      ]
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^[a-z0-9-]+1-[0-9a-f]{32}$"
    }
  }
}
