{
  "$id": "https://kinescope.dev/schema/prediction.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model prediction",
  "type": "object",
  "required": [
    "itemId",
    "answer"
  ],
  "properties": {
    "itemId": {
      "type": "string"
    },
    "answer": {},
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "latencyMs": {
      "type": "number",
      "minimum": 0
    },
    "inputTokens": {
      "type": "integer",
      "minimum": 0
    },
    "outputTokens": {
      "type": "integer",
      "minimum": 0
    },
    "costUsd": {
      "type": "number",
      "minimum": 0
    },
    "metadata": {
      "type": "object"
    }
  }
}
